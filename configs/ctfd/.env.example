# Purple Engine CTFd Environment Configuration
# Copy this file to .env and customize for your deployment

# ==================== Security ====================
# CRITICAL: Change this in production!
CTFD_SECRET_KEY=CHANGE_ME_PLEASE_USE_STRONG_RANDOM_KEY

# Database passwords
MYSQL_ROOT_PASSWORD=ctfd_root_password_change_me
MYSQL_PASSWORD=ctfd_db_password_change_me

# ==================== CTFd Configuration ====================
# Admin credentials for initial setup
CTFD_ADMIN_USERNAME=admin
CTFD_ADMIN_PASSWORD=admin
CTFD_ADMIN_EMAIL=admin@ctfd.local

# ==================== Email Settings (Optional) ====================
# Configure for password resets and notifications
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAILFROM_ADDR=noreply@ctfd.local

# ==================== CTFd API ====================
# Generate API token after first login
# CTFD_API_TOKEN=

# ==================== Purple Engine Integration ====================
# Purple Engine will use these to connect
CTFD_URL=http://localhost:8000
CTFD_USERNAME=admin
CTFD_PASSWORD=admin

# ==================== Challenge Packs ====================
# Directory containing challenge imports
CHALLENGE_PACKS_DIR=./challenge_packs

# ==================== Deployment Mode ====================
# Development: relaxed security, debug logging
# Production: strict security, performance optimized
DEPLOYMENT_MODE=development
